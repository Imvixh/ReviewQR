# ReviewQR local environment template.
# Copy to .env.local and replace these safe placeholders with project values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Development default only. Guided QR generation rejects localhost/private URLs.
# Set this to the actual HTTPS deployment URL before production use.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only AI review suggestions; never expose this key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional application configuration
NEXT_PUBLIC_APP_ENV=development
