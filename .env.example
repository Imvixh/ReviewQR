# ReviewQR local environment template.
# Copy to .env.local and replace these safe placeholders with project values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
SUPABASE_SECRET_KEY=your-supabase-service-role-key-here

# Development default only. Set this to the actual HTTPS deployment URL for production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only AI review suggestions; never expose these keys with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=liquid/lfm-3-1.7b:free

# Optional application configuration
NEXT_PUBLIC_APP_ENV=development
